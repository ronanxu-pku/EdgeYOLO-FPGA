--- /dev/null
+++ b/scripts/ip/bd/lite/precision_ila.tcl
@@ -0,0 +1,32 @@
+# Dedicated Tile 0 precision view. Keep the same probe order for INT8 and INT16.
+set precisionProbes {
+    prec_stage_valid 5
+    prec_act_slice 4
+    prec_weight_slices 16
+    prec_partial_products 32
+    prec_column_sums 56
+    prec_phase_acc 48
+    prec_result_ch0 64
+    prec_phase_sum 48
+}
+create_bd_cell -type ip -vlnv xilinx.com:ip:ila:6.2 precision_ila
+set precisionConfig {
+    CONFIG.C_MONITOR_TYPE Native CONFIG.C_NUM_OF_PROBES 8
+    CONFIG.C_DATA_DEPTH 1024 CONFIG.C_INPUT_PIPE_STAGES 1
+    CONFIG.C_ADV_TRIGGER false CONFIG.C_EN_STRG_QUAL false
+}
+set precisionIdx 0
+foreach {probe width} $precisionProbes {
+    lappend precisionConfig CONFIG.C_PROBE${precisionIdx}_WIDTH $width
+    incr precisionIdx
+}
+set_property -dict $precisionConfig [get_bd_cells precision_ila]
+set precisionIdx 0
+foreach {probe width} $precisionProbes {
+    set pin [get_bd_pins dcim_array_0/$probe]
+    if {1 + [get_property LEFT $pin] - [get_property RIGHT $pin] != $width} {
+        error "Precision probe $probe width differs from $width"
+    }
+    connect_bd_net -net $probe $pin [get_bd_pins precision_ila/probe$precisionIdx]
+    incr precisionIdx
+}
